# Server runtime
NODE_ENV=production
HOST=0.0.0.0
FITNESS_PERSISTENCE=neon

# Set as a provider secret. Do not commit a real value.
DATABASE_URL=

# Public JWKS used to verify signed production JWTs. Store the matching private
# JWK as OAUTH_SIGNING_PRIVATE_JWK only when server-side OAuth issuance is
# enabled. Keep private JWK material in provider secret storage only.
AUTH_JWKS_JSON=

# Private OAuth authorization-code login for MCP connector access.
# OAUTH_CLIENTS_JSON shape:
# [{"id":"fitness-chatgpt","redirectUris":["https://<client-callback>"]}]
OAUTH_CLIENTS_JSON=
OAUTH_PRIVATE_LOGIN_CODE=
OAUTH_SIGNING_PRIVATE_JWK=
OAUTH_USER_ID=user_owner

# Google identity gate for private MCP approval and Telegram linking.
# Create a Google OAuth Web client with redirect URI:
# https://<host>/auth/google/callback
# The Next.js web dashboard can also use the same Google OAuth Web client with:
# https://<web-host>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://<host>/auth/google/callback
GOOGLE_AUTH_ALLOWED_EMAILS=owner@example.com
GOOGLE_AUTH_STATE_SECRET=

# Optional Next.js web dashboard. Deploy `apps/web` as a Vercel Next.js app
# and copy DATABASE_URL plus the Google values above through provider secrets.
NEXT_PUBLIC_FITNESS_BACKEND_URL=https://api.example.com
WEB_AUTH_USER_ID=user_owner
WEB_SESSION_SECRET=
WEB_SESSION_TTL_SECONDS=2592000

# Telegram webhook and outbound bot replies.
# TELEGRAM_WEBHOOK_SECRET_TOKEN must match the Telegram webhook secret.
# TELEGRAM_BOT_TOKEN comes from BotFather and is required for real bot replies.
# TELEGRAM_BOT_USERNAME is non-secret and enables one-tap t.me deep links after
# Google-authenticated account linking.
# TELEGRAM_REMINDER_JOB_SECRET protects the internal reminder-run endpoint that
# GitHub Actions calls on a schedule. Store the same value as a GitHub secret.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_REMINDER_JOB_SECRET=
TELEGRAM_LINK_URL=https://<host>/telegram/link

# Optional Telegram smart coach. Disabled by default because prompts may include
# sensitive health/check-in context and are sent to a third-party model provider.
# OPENROUTER_MODEL defaults to the zero-cost router `openrouter/free`, which has
# low free-tier rate limits and is not a reliability target for production.
TELEGRAM_COACH_LLM_ENABLED=0
TELEGRAM_COACH_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://<host>
OPENROUTER_APP_NAME=Fitness Coach

# Native meal estimation also uses OpenRouter, but it does not inherit
# OPENROUTER_MODEL because that setting is for the Telegram coach. Meal
# estimates use a cheap structured-output model first, then the free router as
# fallback.
MEAL_ESTIMATION_MODEL=openai/gpt-4.1-mini
MEAL_ESTIMATION_VISION_MODEL=openai/gpt-4.1-mini
MEAL_ESTIMATION_FALLBACK_MODEL=openrouter/free
MEAL_ESTIMATION_APP_NAME=Fitness Coach

# MCP protected resource metadata.
# On Render, these default from RENDER_EXTERNAL_URL when not set explicitly.
# Replace <host> with the deployed HTTPS host if you need to override them.
MCP_RESOURCE_URL=https://<host>/mcp
MCP_ISSUER_URL=https://<host>
MCP_AUDIENCE=fitness-mcp
MCP_EXPECTED_SUBJECT=user_owner

# HealthKit/iOS API token validation metadata.
# On Render, issuer/resource default from RENDER_EXTERNAL_URL when not set explicitly.
# Real token issuance is not implemented yet; do not enable fake tokens in hosted Neon environments.
HEALTH_SYNC_TOKEN_ISSUER=https://<host>
HEALTH_SYNC_TOKEN_AUDIENCE=fitness-api
HEALTH_SYNC_TOKEN_RESOURCE=https://<host>
HEALTH_SYNC_EXPECTED_SUBJECT=user_owner

# iOS local run configuration for HealthKit upload testing.
# Put real tokens in a scheme env var or local secret store only.
FITNESS_BACKEND_URL=https://<host>
ALLOW_LIVE_HEALTH_DATA=
ALLOW_HOSTED_HEALTH_BACKEND=
FITNESS_HEALTH_USER_ID=user_owner
FITNESS_HEALTH_SYNC_TOKEN=
