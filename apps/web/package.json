{
  "name": "@fitness/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build:deps": "npm run build -w @fitness/auth && npm run build -w @fitness/domain && npm run build -w @fitness/db && npm run build -w @fitness/server",
    "prebuild": "npm run build:deps",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fitness/auth": "0.0.0",
    "@fitness/db": "0.0.0",
    "@fitness/domain": "0.0.0",
    "@fitness/server": "0.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.561.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "8.5.26",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
